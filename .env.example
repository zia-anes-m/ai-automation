# ====================================================================
# AGENT-SYNC Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (server/.env or Hosting Environment)
# --------------------------------------------------------------------
PORT=5000

# Allowed CORS Origins (Comma-separated list)
# In production, set this to your Vercel frontend URL:
CORS_ORIGIN=https://autonomous-ai-agents.vercel.app,http://localhost:5173,http://localhost:3000

# Optional Server-Side LLM API Keys (Instant Simulation works with zero keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (client/.env or Vercel Settings)
# --------------------------------------------------------------------
# In Local Development (Leave empty to use Vite's automatic localhost proxy):
# VITE_API_URL=
# VITE_WS_URL=

# In Production (Add these in Vercel -> Project Settings -> Environment Variables):
# VITE_API_URL=https://<your-deployed-backend-domain>
# VITE_WS_URL=wss://<your-deployed-backend-domain>/ws
